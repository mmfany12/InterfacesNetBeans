<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fanny.divisores.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox spacing="15.0" alignment="CENTER_LEFT">
         <children>
             <Label text="CIFRAS Y DIVISORES DE UN NÚMERO" />
            <Label text="Ingrese un número" />
            <TextField fx:id="txtNumero" text="9999" prefWidth="120.0" />
            <Button text="Analizar" onAction="#btnControl_click1" />
            <Button text="Limpiar" onAction="#btnControl_click2" />
         </children>
      </HBox>
      <HBox spacing="30.0">
         <children>
            <VBox spacing="10.0">
               <children>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <Label text="Cantidad de dígitos" prefWidth="140.0" />
                     <TextField fx:id="txtcantDigitos" editable="false" prefWidth="100.0" />
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <Label text="Suma de dígitos impares" prefWidth="140.0" />
                     <TextField fx:id="txtsumaImp" editable="false" prefWidth="100.0" />
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <Label text="Suma de dígitos pares" prefWidth="140.0" />
                     <TextField fx:id="txtsumaPar" editable="false" prefWidth="100.0" />
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <Label text="Suma total de dígitos" prefWidth="140.0" />
                     <TextField fx:id="txtsumaTotal" editable="false" prefWidth="100.0" />
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <Label text="Dígito mayor" prefWidth="140.0" />
                     <TextField fx:id="txtDigMayor" editable="false" prefWidth="100.0" />
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <Label text="Dígito menor" prefWidth="140.0" />
                     <TextField fx:id="txtDigMenor" editable="false" prefWidth="100.0" />
                  </HBox>
               </children>
            </VBox>
            
            <!-- Columna Derecha: Divisores -->
            <VBox spacing="5.0">
               <children>
                  <Label text="Divisores" />
                  <TextArea fx:id="txtDivisores" prefRowCount="10" prefColumnCount="18" editable="false" wrapText="true" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>