<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fanny.desglosedinero.PrimaryController">
    <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox spacing="10.0" alignment="CENTER_LEFT">
        <children>
        <Label text="Desglose de dinero" />
        <Label text="Dinero:" />
        <TextField fx:id="txtDinero" text = "9999" />
        <Button text="Desglosar" onAction="#btnControl_click1"/>
        <Button text="X" onAction="#btnControl_click2"/>
        </children>
      </HBox>
      <HBox spacing="10.0">
          <children>
              <TextArea fx:id="txtDatos" prefRowCount="10" prefColumnCount="18" editable="false" wrapText="true"/>
              <TextArea fx:id="txtValor" prefRowCount="10" prefColumnCount="8" editable="false" wrapText="true"/>
          </children>
      </HBox>
    </children>
</VBox>