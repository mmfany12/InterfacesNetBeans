<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fanny.controlgastossemanales.PrimaryController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <Label text="Control de Gastos Semanales" />
      <HBox spacing="40.0">
         <children>
            <VBox spacing="10.0">
               <children>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="Alimentación" prefWidth="100.0" />
                        <TextField fx:id="txtAlimentacion" alignment="CENTER_RIGHT" prefWidth="100.0" />
                     </children>
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="Refrigerios" prefWidth="100.0" />
                        <TextField fx:id="txtRefrigerios" alignment="CENTER_RIGHT" prefWidth="100.0" />
                     </children>
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="Transporte" prefWidth="100.0" />
                        <TextField fx:id="txtTransporte" alignment="CENTER_RIGHT" prefWidth="100.0" />
                     </children>
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="Telefonía" prefWidth="100.0" />
                        <TextField fx:id="txtTelefonia" alignment="CENTER_RIGHT" prefWidth="100.0" />
                     </children>
                  </HBox>
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="Otros" prefWidth="100.0" />
                        <TextField fx:id="txtOtros" alignment="CENTER_RIGHT" prefWidth="100.0" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="12.0">
               <children>
                  <Label text="Estadísticas" style="-fx-font-weight: bold;" />
                  <Label text="Total semanal" />
                  <TextField fx:id="txtTotal" editable="false" alignment="CENTER_RIGHT" prefWidth="120.0" />
                  <Label text="Gasto más alto" />
                  <TextField fx:id="txtGasAlto" editable="false" alignment="CENTER_CENTER" prefWidth="120.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox spacing="15.0" alignment="CENTER_LEFT">
         <children>
            <Button text="Calcular estadísticas" onAction="#btnCalcular_click1" prefWidth="140.0" />
            <Button text="Limpiar" onAction="#btnLimpiar_click2" prefWidth="100.0" />
         </children>
      </HBox>
   </children>
</VBox>